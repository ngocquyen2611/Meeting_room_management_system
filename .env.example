# =========================
# PostgreSQL
# =========================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_room
POSTGRES_PORT=5432


# =========================
# RabbitMQ
# =========================

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672


# =========================
# Room Service
# =========================

ROOM_SERVICE_PORT=8001
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meeting_room
RABBITMQ_URL=amqp://admin:admin@localhost:5672/


# =========================
# Gateway
# =========================

GATEWAY_PORT=8000


# =========================
# Frontend
# =========================

VITE_API_BASE_URL=http://localhost:8000